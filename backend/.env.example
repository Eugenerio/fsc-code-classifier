# Copy to backend/.env and fill in. Every key is optional; the pipeline degrades gracefully:
#   Gemini + Jev  -> full pipeline (OCR, profiling, 3-channel recall, Jev verification)
#   Gemini only   -> Gemini acts as the judge
#   no keys       -> heuristic profile + BM25 retrieval only (still returns codes)
GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# TYPESAFE_MODEL=jev-latest   # pin a version (jev-1.13.0) so cached answers keep meaning the same thing
# DECIDER=auto            # auto | jev | gemini | retrieval
# ENABLE_WEB_RESEARCH=true

# Repeatability: the same input gives the same codes
# GEMINI_SEED=7           # fixed sampling seed on every Gemini call; "none" = random each call
# GEMINI_TEMPERATURE=     # force a temperature; gemini-3 models otherwise use their default of 1.0
# LLM_CACHE=true          # keep Gemini and Jev answers on disk (backend/.cache/llm); false = measure raw model variance
